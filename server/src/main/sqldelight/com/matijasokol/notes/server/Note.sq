CREATE TABLE IF NOT EXISTS NoteEntity (
    id UUID PRIMARY KEY,
    text TEXT NOT NULL,
    userId UUID NOT NULL REFERENCES UserEntity(id) ON DELETE CASCADE,
    createdAt BIGINT NOT NULL
);

CREATE INDEX IF NOT EXISTS index_noteEntity_userId ON NoteEntity(userId);

insert:
INSERT INTO NoteEntity (id, text, userId, createdAt) VALUES (?, ?, ?, ?);

getAllByUserId:
SELECT id, text, userId, createdAt FROM NoteEntity WHERE userId = ?;

getById:
SELECT id, text, userId, createdAt FROM NoteEntity WHERE id = ?;

delete:
DELETE FROM NoteEntity WHERE id = ? RETURNING id;